diff --git a/tools/clean_headers.sh b/tools/clean_headers.sh
index 44053a3..4716f00 100755
--- a/tools/clean_headers.sh
+++ b/tools/clean_headers.sh
@@ -6,3 +6,33 @@ export ANDROID_BUILD_TOP="$PWD"
 ./bionic/libc/kernel/tools/clean_header.py -u \
     "$1/usr/include/asm/signal.h" \
     "$1/usr/include/asm-generic/signal.h"
+
+# local(22-to-16 port): drop struct sched_param from the exported copy of
+# linux/sched/types.h.
+#
+# headers_install copies the kernel uapi into usr/include/.  The 5.10.230
+# (lineage-22.1) uapi exports struct sched_param from linux/sched/types.h, and
+# bionic/libc/include/sched.h includes that very header (line 40) *and* declares
+# struct sched_param itself (line 99), because the uapi baseline this tree
+# expects only carries sched_attr there.  The result is a hard redefinition:
+#
+#   bionic/libc/include/sched.h:99:8: error: redefinition of sched_param
+#   .../generated_kernel_includes/gen/usr/include/linux/sched/types.h:7:8:
+#       note: previous definition is here
+#
+# The header cannot simply be removed: bionic and SurfaceFlinger both include it
+# by name for sched_attr.  Removing just the four-line struct declaration keeps
+# sched_attr (and the SCHED_ATTR_SIZE_VER* macros) intact and matches the newer
+# uapi baseline, without touching the kernel ABI sources.
+HDR="$1/usr/include/linux/sched/types.h"
+if [ -f "$HDR" ]; then
+    python3 - "$HDR" << "PYEOF"
+import io, re, sys
+p = sys.argv[1]
+s = io.open(p, encoding="utf-8").read()
+new, n = re.subn(r"struct sched_param \{\n\s*int sched_priority;\n\};\n", "", s)
+if n:
+    io.open(p, "w", encoding="utf-8").write(new)
+    sys.stderr.write("clean_headers: removed %d struct sched_param block(s) from %s\n" % (n, p))
+PYEOF
+fi
