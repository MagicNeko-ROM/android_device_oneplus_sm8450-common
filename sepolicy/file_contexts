# Third-party Vulkan drivers living next to the OEM vulkan.adreno.so.
# The qcom sepolicy only labels vulkan.<soc>.so as same_process_hal_file, so
# any additional ICD (Mesa Turnip here) needs its own rule, otherwise apps get
# avc denied on read and the loader ends up with no physical device.
/vendor/lib(64)?/hw/vulkan\.freedreno\.so    u:object_r:same_process_hal_file:s0
/data/misc/vulkan(/.*)?    u:object_r:vulkan_perapp_conf_file:s0

# The proxy fingerprint HAL runs in the same domain as the original
# implementation. It needs the same exec type for that, not vendor_file.
/vendor/bin/android\.hardware\.biometrics\.fingerprint-service\.proxy    u:object_r:hal_fingerprint_default_exec:s0
# The ICD switcher and its image-default config.
/vendor/lib(64)?/hw/vulkan\.switcher\.so    u:object_r:same_process_hal_file:s0
