# Per-application Vulkan ICD selection.
#
# libvulkan lives inside the calling process and reads
#   /data/misc/vulkan/per_app.conf
# (falling back to ro.hardware.vulkan) to decide which ICD to load. Because
# that reader can be any app or native service, the read permission has to
# cover every domain that can create a Vulkan instance - not just
# untrusted_app. The `appdomain` macro covers untrusted_app, platform_app,
# priv_app, system_app and friends; gpuservice runs in its own domain and is
# added explicitly.
type vulkan_perapp_conf_file, file_type, data_file_type, core_data_file_type;

# Any app process that creates a Vulkan instance.
allow appdomain vulkan_perapp_conf_file:dir { search r_dir_perms };
allow appdomain vulkan_perapp_conf_file:file r_file_perms;

# gpuservice backs `cmd gpu` / the Vulkan reporting path.
allow gpuservice vulkan_perapp_conf_file:dir { search r_dir_perms };
allow gpuservice vulkan_perapp_conf_file:file r_file_perms;

# Owner: the privileged settings app rewrites the mapping.
allow system_app vulkan_perapp_conf_file:dir { create_dir_perms r_dir_perms };
allow system_app vulkan_perapp_conf_file:file { create_file_perms rw_file_perms };

# init creates /data/misc/vulkan from a *system* rc file (vulkan_perapp.rc),
# not from a vendor one. Commands in vendor rc files run as vendor_init, which
# has no write on /data/misc, so every boot logged:
#   avc: denied { write } for comm="init" name="misc"
#     scontext=u:r:vendor_init:s0 tcontext=u:object_r:system_data_file:s0
# and the mkdir was dropped on the floor. The real init domain already creates
# /data/misc/keystore and friends, so it is the right owner for this one.
# setattr covers the chown/chmod; relabelfrom/relabelto are what the trailing
# restorecon needs to give the directory its own type, because vendor policy
# cannot declare a type_transition from a platform domain.
allow init vulkan_perapp_conf_file:dir { create_dir_perms setattr relabelfrom relabelto };
allow init vulkan_perapp_conf_file:file { create_file_perms setattr relabelfrom relabelto };
allow init system_data_file:dir relabelfrom;

# Root shell (adb root / su) is the escape hatch for editing the mapping
# without a settings UI: no app has to be involved to switch an ICD.
allow su vulkan_perapp_conf_file:dir { search r_dir_perms write add_name };
allow su vulkan_perapp_conf_file:file { rw_file_perms create_file_perms };
