        <item>/apex/com.android.art/javalib/arm/boot.vdex</item>
        <item>/apex/com.android.art/javalib/arm64/boot-core-libart.vdex</item>
        <item>/apex/com.android.art/javalib/arm/boot-core-libart.vdex</item>
